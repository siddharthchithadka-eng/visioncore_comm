<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_PutBool" Id="{649d6872-34ce-4c23-b95b-af1bb85756f4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_PutBool : BOOL
// Writes Bool (1 byte, little-endian) at Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR_INPUT
    Value : BOOL;
END_VAR
VAR
    nByte : BYTE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[nByte := BOOL_TO_BYTE(Value);   // wire: 0 or 1
VC_PutBool := VC_PutRaw(Buf := Buf, Pos := Pos, pSrc := ADR(nByte), Size := 1);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
