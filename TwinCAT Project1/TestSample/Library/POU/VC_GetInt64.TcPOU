<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_GetInt64" Id="{648103b8-03fa-4b7e-b2bc-bc568badabd2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_GetInt64 : LINT
// Reads Int64 (8 byte, little-endian) from Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR
    nVal : LINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[nVal := 0;
VC_GetRaw(Buf := Buf, Pos := Pos, pDst := ADR(nVal), Size := 8);
VC_GetInt64 := nVal;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
