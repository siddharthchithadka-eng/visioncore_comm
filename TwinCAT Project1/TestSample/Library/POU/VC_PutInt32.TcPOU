<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_PutInt32" Id="{dfaa2eba-5e26-4632-b7b7-29f6138597a4}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_PutInt32 : BOOL
// Writes Int32 (4 byte, little-endian) at Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR_INPUT
    Value : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[VC_PutInt32 := VC_PutRaw(Buf := Buf, Pos := Pos, pSrc := ADR(Value), Size := 4);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
