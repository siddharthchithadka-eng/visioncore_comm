<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_PutFloat64" Id="{4b28593d-3ca7-4b64-a460-90e4a6e53537}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_PutFloat64 : BOOL
// Writes Float64 (8 byte, little-endian) at Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR_INPUT
    Value : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[VC_PutFloat64 := VC_PutRaw(Buf := Buf, Pos := Pos, pSrc := ADR(Value), Size := 8);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
