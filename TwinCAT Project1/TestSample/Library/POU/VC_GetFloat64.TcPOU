<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_GetFloat64" Id="{a472ea2f-b829-4ff8-b8ca-2252bd7256e2}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_GetFloat64 : LREAL
// Reads Float64 (8 byte, little-endian) from Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR
    nVal : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[nVal := 0;
VC_GetRaw(Buf := Buf, Pos := Pos, pDst := ADR(nVal), Size := 8);
VC_GetFloat64 := nVal;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
