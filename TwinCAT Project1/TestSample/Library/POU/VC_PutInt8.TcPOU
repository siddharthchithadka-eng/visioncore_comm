<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_PutInt8" Id="{5b07ebf8-c105-42c9-9906-8a5c3c74b8a3}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_PutInt8 : BOOL
// Writes Int8 (1 byte, little-endian) at Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR_INPUT
    Value : SINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[VC_PutInt8 := VC_PutRaw(Buf := Buf, Pos := Pos, pSrc := ADR(Value), Size := 1);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
