<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <DUT Name="ST_VC_LinkData" Id="{6d0a6539-dcda-49c8-8f1c-fa1e94d43ca4}">
    <Declaration><![CDATA[TYPE ST_VC_LinkData :
STRUCT
    // State
    State          : E_VC_LinkState;
    Online         : BOOL;
    NowMs          : UDINT;      // time base, set by VC_Link every cycle
    StateSinceMs   : UDINT;
    LastRxMs       : UDINT;
    LastTxMs       : UDINT;
    NextCallId     : UDINT;      // 1 .. 16#7FFFFFFF, bit 31 always 0

    // Release from HelloAck and handler presence, index = method index
    MethodState    : ARRAY[0..VC_MAX_METHODS - 1] OF USINT;  // 0 unknown, 1 released, 2 hash, 3 not allowed
    HandlerSeenMs  : ARRAY[0..VC_MAX_METHODS - 1] OF UDINT;

    // Call slots
    OutSlots       : ARRAY[0..VC_MAX_CALLS - 1] OF ST_VC_OutSlot;
    InSlots        : ARRAY[0..VC_MAX_CALLS - 1] OF ST_VC_InSlot;
    NextOutSend    : UINT;       // round robin for sending

    // Control messages
    CtrlQueue      : ARRAY[0..VC_CTRL_QUEUE - 1] OF ST_VC_CtrlMsg;
    CtrlHead       : UINT;
    CtrlCount      : UINT;

    // Buffers
    RxBuffer       : ARRAY[0..VC_RX_BUFFER - 1] OF BYTE;
    RxFill         : UDINT;
    TxFrame        : ARRAY[0..VC_HEADER_LEN + VC_MAX_PAYLOAD - 1] OF BYTE;

    // Diagnostics
    Diag           : ST_VC_Diag;
END_STRUCT
END_TYPE]]></Declaration>
  </DUT>
</TcPlcObject>
