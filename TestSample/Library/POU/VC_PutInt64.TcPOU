<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_PutInt64" Id="{ee95fad8-9891-401f-89fa-41e9e8e3962e}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_PutInt64 : BOOL
// Writes Int64 (8 byte, little-endian) at Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR_INPUT
    Value : LINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[VC_PutInt64 := VC_PutRaw(Buf := Buf, Pos := Pos, pSrc := ADR(Value), Size := 8);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
