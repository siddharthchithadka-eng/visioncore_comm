<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_PutInt16" Id="{1f656240-b880-447b-add8-0d163019885a}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_PutInt16 : BOOL
// Writes Int16 (2 byte, little-endian) at Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR_INPUT
    Value : INT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[VC_PutInt16 := VC_PutRaw(Buf := Buf, Pos := Pos, pSrc := ADR(Value), Size := 2);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
