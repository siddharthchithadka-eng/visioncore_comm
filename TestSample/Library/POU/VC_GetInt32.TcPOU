<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_GetInt32" Id="{28458e1d-86b2-4586-8d87-0db1393cdd4b}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_GetInt32 : DINT
// Reads Int32 (4 byte, little-endian) from Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR
    nVal : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[nVal := 0;
VC_GetRaw(Buf := Buf, Pos := Pos, pDst := ADR(nVal), Size := 4);
VC_GetInt32 := nVal;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
