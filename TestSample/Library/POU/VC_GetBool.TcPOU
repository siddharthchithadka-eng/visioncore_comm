<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_GetBool" Id="{da520ad8-6b3e-4838-aea7-20d7e4599c1d}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_GetBool : BOOL
// Reads Bool (1 byte, little-endian) from Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR
    nByte : BYTE;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[nByte := 0;
VC_GetRaw(Buf := Buf, Pos := Pos, pDst := ADR(nByte), Size := 1);
VC_GetBool := (nByte <> 0);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
