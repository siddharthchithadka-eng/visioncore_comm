<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_GetUInt64" Id="{bf7f822e-2a69-43dc-a576-6457b8c60899}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_GetUInt64 : ULINT
// Reads UInt64 (8 byte, little-endian) from Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR
    nVal : ULINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[nVal := 0;
VC_GetRaw(Buf := Buf, Pos := Pos, pDst := ADR(nVal), Size := 8);
VC_GetUInt64 := nVal;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
