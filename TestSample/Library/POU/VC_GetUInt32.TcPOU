<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_GetUInt32" Id="{d334cd79-5f2b-42e7-a459-1b30c0662791}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_GetUInt32 : UDINT
// Reads UInt32 (4 byte, little-endian) from Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR
    nVal : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[nVal := 0;
VC_GetRaw(Buf := Buf, Pos := Pos, pDst := ADR(nVal), Size := 4);
VC_GetUInt32 := nVal;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
