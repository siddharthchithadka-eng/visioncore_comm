<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4024.12">
  <POU Name="VC_PutUInt32" Id="{6cc5b823-ef76-40d6-adb4-e9fe7d6f9895}" SpecialFunc="None">
    <Declaration><![CDATA[FUNCTION VC_PutUInt32 : BOOL
// Writes UInt32 (4 byte, little-endian) at Buf[Pos] and advances Pos.
VAR_IN_OUT
    Buf   : ARRAY[*] OF BYTE;
    Pos   : UDINT;
END_VAR
VAR_INPUT
    Value : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[VC_PutUInt32 := VC_PutRaw(Buf := Buf, Pos := Pos, pSrc := ADR(Value), Size := 4);]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>
